    "llm",
    "local-ai",
    "knowledge-management"
  ],
  "author": "Weiluntsou",
  "homepage": "https://github.com/weiluntsou/obsidian-local-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiluntsou/obsidian-local-agent.git"
  },
  "bugs": {
    "url": "https://github.com/weiluntsou/obsidian-local-agent/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.14.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  }
}
