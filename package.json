  "description": "An Obsidian plugin that interfaces with local LLMs for automated knowledge management.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
